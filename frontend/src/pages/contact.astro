---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHead from "../components/PageHead.astro";
import ContactForm from "../components/ContactForm.jsx";
import {
  PHONE,
  PHONE_HREF,
  EMAIL,
  ADDRESS,
  HOURS,
} from "../data/site.js";

const mapQuery = encodeURIComponent(
  `${ADDRESS.street}, ${ADDRESS.city}, ${ADDRESS.state} ${ADDRESS.zip}`
);
---

<BaseLayout
  title="Contact"
  description="Request plumbing, mechanical, or excavation service from Capital City Mechanical in Grove City, Ohio. 24/7 emergency dispatch at (614) 871-8100."
>
  <PageHead
    eyebrow="Get a truck scheduled"
    title="Contact"
    lede="Send the details and a dispatcher will call you back. If it is an emergency, skip the form and call — the phone is faster than we are."
  />

  <section class="band">
    <div class="shell contact">
      <div class="contact__form">
        <p class="spec-tag">Service request</p>
        <h2>Tell us about the job</h2>
        <ContactForm client:load />
      </div>

      <aside class="contact__side">
        <div class="panel panel--call">
          <p class="panel__label">Emergency &amp; dispatch</p>
          <a class="panel__phone" href={PHONE_HREF}>{PHONE}</a>
          <p class="dim">
            Answered around the clock for active leaks, sewer backups, and
            burst lines.
          </p>
        </div>

        <div class="panel">
          <p class="panel__label">Shop</p>
          <address>
            {ADDRESS.street}<br />
            {ADDRESS.city}, {ADDRESS.state} {ADDRESS.zip}
          </address>
          <a
            class="panel__link"
            href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`}
            target="_blank"
            rel="noopener"
          >
            Get directions →
          </a>
        </div>

        <div class="panel">
          <p class="panel__label">Email</p>
          <a class="panel__link" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        </div>

        <div class="panel">
          <p class="panel__label">Hours</p>
          <dl class="hours">
            {
              HOURS.map((h) => (
                <div>
                  <dt>{h.days}</dt>
                  <dd>{h.time}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="panel">
          <p class="panel__label">Service area</p>
          <p class="dim">
            Columbus, Grove City, Hilliard, Dublin, Westerville, Reynoldsburg,
            Pickerington, Lancaster, and the rest of Central Ohio.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <section class="map-band">
    <iframe
      title="Map to Capital City Mechanical in Grove City, Ohio"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}></iframe>
  </section>
</BaseLayout>

<style>
  .contact {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    align-items: start;
  }

  @media (max-width: 900px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }

  .contact__form h2 {
    margin-bottom: 1.75rem;
  }

  .contact__side {
    display: grid;
    gap: 1rem;
  }

  .panel {
    background: var(--ink-3);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 1.25rem 1.4rem;
  }

  .panel--call {
    border-top: 3px solid var(--orange);
  }

  .panel__label {
    font-family: var(--display);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }

  .panel__phone {
    display: block;
    font-family: var(--display);
    font-size: clamp(1.9rem, 3vw, 2.4rem);
    font-weight: 700;
    line-height: 1;
    color: var(--orange);
    text-decoration: none;
    margin-bottom: 0.75rem;
  }

  .panel address {
    font-style: normal;
    color: var(--paper-dim);
    margin-bottom: 0.75rem;
  }

  .panel__link {
    font-family: var(--display);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--steel-bright);
    text-decoration: none;
  }

  .panel__link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .panel p {
    margin: 0;
  }

  .hours {
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }

  .hours > div {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .hours dt {
    color: var(--paper-dim);
    font-size: 0.9rem;
  }

  .hours dd {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .map-band {
    border-top: 1px solid var(--line);
    line-height: 0;
  }

  .map-band iframe {
    width: 100%;
    height: clamp(18rem, 40vh, 26rem);
    border: 0;
    filter: grayscale(1) invert(0.9) contrast(0.85);
  }
</style>
