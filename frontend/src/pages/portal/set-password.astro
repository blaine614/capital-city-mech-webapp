---
import "../../styles/portal.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHead from "../../components/PageHead.astro";
import SetPassword from "../../components/portal/SetPassword.jsx";
---

<BaseLayout
  title="Set your password"
  description="Choose a password for the Capital City Mechanical employee portal."
  noindex
>
  <PageHead
    eyebrow="Employee portal"
    title="Set your password"
    lede="Choose the password you will use to sign in to the employee portal."
  />

  <section class="band">
    <div class="shell">
      <SetPassword client:only="react" />
      <noscript>
        <p class="dim">The employee portal needs JavaScript turned on in your browser.</p>
      </noscript>
    </div>
  </section>
</BaseLayout>
