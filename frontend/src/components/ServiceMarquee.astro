---
// Signature element: a skewed, full-bleed band of trade names that runs
// across the page like a strip of pipe tape. Content is the real service list.
const { items, tone = "orange" } = Astro.props;
const track = [...items, ...items];
---

<div class={`marquee marquee--${tone}`} aria-hidden="true">
  <div class="marquee__track">
    {
      track.map((item) => (
        <span class="marquee__item">
          {item}
          <b>◆</b>
        </span>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    /* Full-bleed and level: the band spans the viewport exactly, so no
       overhang is needed to cover rotated corners. */
    position: relative;
    width: 100vw;
    left: 50%;
    margin-left: -50vw;
    overflow: hidden;
    padding-block: 0.7rem;
    border-block: 2px solid rgba(0, 0, 0, 0.35);
    margin-block: clamp(2rem, 5vw, 3.5rem);
  }

  .marquee--orange {
    background: var(--orange);
    color: #12161a;
  }

  .marquee--steel {
    background: var(--steel-dim);
    color: var(--paper);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: slide 42s linear infinite;
  }

  .marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 1.75rem;
    padding-right: 1.75rem;
    font-family: var(--display);
    font-size: clamp(1.05rem, 2vw, 1.5rem);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .marquee__item b {
    font-size: 0.6em;
    opacity: 0.5;
  }

  @keyframes slide {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }
  }
</style>
